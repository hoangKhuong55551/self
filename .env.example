# Sao chép thành .env rồi chỉnh giá trị. KHÔNG commit file .env.
DJANGO_DEBUG=True
# Tạo key mới: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# Danh sách cách nhau bởi dấu phẩy (bắt buộc khi DEBUG=False)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Chỉ áp dụng khi DEBUG=False
DJANGO_SECURE_COOKIES=True
DJANGO_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=0

# Đường dẫn trang admin (vd: quan-tri-x7k2/). Mặc định admin/
DJANGO_ADMIN_URL=admin/
# Khoá đăng nhập sau N lần sai trong M phút
DJANGO_LOGIN_FAILURE_LIMIT=5
DJANGO_LOGIN_COOLOFF_MINUTES=15
# True nếu chạy sau reverse proxy (nginx, Render, Railway...) để lấy đúng IP người dùng
DJANGO_BEHIND_PROXY=False
# False = tắt trang đăng ký (app chỉ cho riêng bạn)
DJANGO_ALLOW_REGISTRATION=True
# False khi đã có cron chạy `python manage.py process_subscriptions` mỗi ngày
DJANGO_CHARGE_SUBSCRIPTIONS_ON_REQUEST=True

# ── Deploy (Render + Neon). Xem DEPLOY.md ──
# Chuỗi kết nối Postgres; bỏ trống = dùng db.sqlite3 trên máy
DATABASE_URL=
# 'db' = lưu ảnh tải lên trong database (host không có ổ đĩa lâu dài như Render miễn phí)
DJANGO_FILE_STORAGE=filesystem
# Khoá cho đường link /cron/<khoá>/ (ít nhất 20 ký tự)
DJANGO_CRON_SECRET=
# Thông báo đẩy: python manage.py generate_vapid_keys
DJANGO_VAPID_PUBLIC_KEY=
DJANGO_VAPID_PRIVATE_KEY=
DJANGO_VAPID_SUBJECT=mailto:ban@example.com
